{
  "name": "swiftlift-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Android packaging for Swiftlift (Capacitor wrapper around the offline-vendored www/ build). Independent of the root package.json — does not affect the web PWA.",
  "scripts": {
    "build:www": "node scripts/build-www.js && tailwindcss -i src/tailwind-input.css -o www/vendor/tailwind.css --minify",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.0",
    "@capacitor/cli": "^8.4.2",
    "@fontsource/manrope": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19"
  }
}
